#!/usr/bin/env bash
# Pre-commit: refuse a staged secret (gitleaks v8.25+, when installed) or a hit from the maintainer's
# private denylist scanner (when labs.denylistScan is set) in the staged paths and added lines.
# gitleaks runs with CI's flags: inline gitleaks:allow comments are ignored and a .gitleaksignore file
# is refused. Only CI checks the allow-list's shape. commit-msg scans the message. Enable once per clone:
#   git config core.hooksPath scripts/hooks
#   git config labs.denylistScan /path/to/private/scan.sh   # optional; never commit that file
# The scanner gets two files, the staged paths and the added lines, and must exit non-zero on a hit;
# when it prints file:line for each hit, the hook names the staged path or the path:line of the added
# line. Paths are written without git's quotes; control characters in a name stay escaped (\t, \n).
set -u
rc=0
hint="gitleaks git --pre-commit --staged --redact --ignore-gitleaks-allow ."
if command -v gitleaks >/dev/null 2>&1; then
  ignore="$(find . -name .gitleaksignore -not -path './.git/*' 2>/dev/null)"
  if [ -n "$ignore" ]; then
    echo "pre-commit: remove .gitleaksignore (CI refuses it; allow-list in .gitleaks.toml instead): $ignore" >&2
    rc=1
  else
    gitleaks git --pre-commit --staged --redact --no-banner --ignore-gitleaks-allow --exit-code 3 \
      --config .gitleaks.toml . >/dev/null 2>&1
    case $? in
      0) ;;
      3) echo "pre-commit: gitleaks found a secret in the staged diff (run: $hint)" >&2; rc=1 ;;
      *) echo "pre-commit: gitleaks failed to run; it needs v8.25+ and a valid .gitleaks.toml (run: $hint)" >&2; rc=1 ;;
    esac
  fi
else
  echo "pre-commit: gitleaks not on PATH; secret scan skipped (CI still scans)" >&2
fi

scan="$(git config --type=path --get labs.denylistScan)"
case $? in
  0) ;;
  1) scan="" ;;
  *) echo "pre-commit: cannot read labs.denylistScan (a ~user/ path that does not expand?)" >&2; exit 1 ;;
esac
if [ -n "$scan" ]; then
  [ -x "$scan" ] || { echo "pre-commit: labs.denylistScan is set but $scan is missing or not executable" >&2; exit 1; }
  paths="$(mktemp)"
  lines="$(mktemp)"
  where="$(mktemp)"
  out="$(mktemp)"
  trap 'rm -f "$paths" "$lines" "$where" "$out"' EXIT
  # unq: a path as git prints it, without git's quotes: \\ and \" are undone, other escapes are kept.
  unq='function unq(s,   r, i, c, n) {
    if (s !~ /^".*"$/) return s
    r = ""
    for (i = 2; i < length(s); i++) {
      c = substr(s, i, 1); n = substr(s, i + 1, 1)
      if (c == "\\" && (n == "\\" || n == "\"")) { c = n; i++ }
      r = r c
    }
    return r
  }'
  git -c core.quotePath=false diff --cached --name-only --no-renames --diff-filter=d | awk "$unq"'{ print unq($0) }' > "$paths"
  # Each added line goes to $lines, and its path:line to the same line of $where.
  git -c core.quotePath=false diff --cached -U0 --no-color --no-ext-diff --no-renames --src-prefix=a/ --dst-prefix=b/ \
    | awk -v where="$where" "$unq"'
        /^diff --git / { h = 1; next }
        h && /^\+\+\+ / { f = substr($0, 5); sub(/\t$/, "", f); f = unq(f); sub(/^b\//, "", f); next }
        /^@@/ { h = 0; split($3, a, ","); n = substr(a[1], 2) + 0; next }
        !h && /^\+/ { print substr($0, 2); print f ":" n > where; n++ }' > "$lines"
  if ! "$scan" "$paths" "$lines" > "$out"; then
    echo "pre-commit: private denylist hit in the staged paths or added lines" >&2
    awk -v paths="$paths" -v lines="$lines" -v where="$where" '
      BEGIN { while ((getline l < paths) > 0) p[++np] = l; while ((getline l < where) > 0) w[++nw] = l }
      index($0, paths ":") == 1 { n = substr($0, length(paths) + 2) + 0; if (n in p) { print "  staged path: " p[n]; hit = 1 } }
      index($0, lines ":") == 1 { n = substr($0, length(lines) + 2) + 0; if (n in w) { print "  added line:  " w[n]; hit = 1 } }
      END { exit !hit }' "$out" >&2 \
      || printf '  locate: cd %q && git diff --cached --name-only --diff-filter=d -z | xargs -0 %q /dev/null\n' "$PWD" "$scan" >&2
    rc=1
  fi
fi
exit "$rc"
