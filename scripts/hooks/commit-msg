#!/usr/bin/env bash
# commit-msg: run the maintainer's private denylist scanner (when configured) over the message as the
# editor flow records it: no `#` comment lines and no `-v` diff. See scripts/hooks/pre-commit for setup.
set -u
scan="$(git config --type=path --get labs.denylistScan || true)"
[ -n "$scan" ] || exit 0
[ -x "$scan" ] || { echo "commit-msg: labs.denylistScan is set but $scan is missing or not executable" >&2; exit 1; }
msg="$(mktemp)"
trap 'rm -f "$msg"' EXIT
sed '/^# -\{24\} >8 -\{24\}$/,$d' "$1" | git stripspace --strip-comments > "$msg"
# /dev/null makes the scanner print file:line rather than the matched text.
"$scan" "$msg" /dev/null >/dev/null || { echo "commit-msg: private denylist hit in the commit message" >&2; exit 1; }
